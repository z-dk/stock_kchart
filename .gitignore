# Miscellaneous
.trae/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code local config (launch.json, settings.json may contain paths / snippets specific to this machine)
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Flutter 3.x: plugin config in .dart_tool
.dart_tool/package_config.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Android signing keys (CRITICAL — never commit keystore files!)
/android/*.jks
/android/*.keystore
/android/app/*.jks
/android/app/*.keystore
/android/app/*.key
/android/app/*key.properties
/android/key.properties

# Gradle user home (caches)
/.gradle/
/android/local.properties
/android/.gradle/

# IDE local state — may contain personal paths, login tokens, debug config
.idea/workspace.xml
.idea/tasks.xml
.idea/debug.xml
.idea/gradle.xml
.idea/misc.xml
.vscode/settings.json

# Flutter .metadata
.flutter-plugins

# Dart analysis output
/analysis_options.log
/pubspec.lock.bak

# Local env / config that often holds secrets
.env
.env.*
.localconfig*
*.pem
*.p12
*.pfx
*.cer
*.crt

# API keys / secrets in project assets
assets/config/default_keys.json

# Tool-generated logs
tool/*_log.txt

# OS / generated
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Vendored k_chart: only ship lib/ + pubspec + license, not its example app
# (the example brings in iOS/macOS/Windows/Linux platform files & icons).
packages/k_chart/example/
